get OS

if OS==Windows_NT then
  let PYNAME = python
  let RM = del /f
  let OS_DIST = dist\\
elif OS==linux then
  let PYNAME = python3
  let RM = rm -rf
  let OS_DIST = dist/
else then
  let PYNAME = python3
  let RM = rm -rf
  let OS_DIST = dist/
done

recipe clean
recipe full
let PROGRAM = arghandle

clean:
  shell (RM) (PROGRAM)-* (PROGRAM).egg-info (OS_DIST) build
full:
  (PYNAME) -m build
  (PYNAME) -m twine upload (OS_DIST)*

