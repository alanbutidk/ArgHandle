# You need autobuild installed for this :) and this wont work on your PC, dont be excited...
# This is for me [lol :))))]

get OS

if OS==Windows_NT then
  let PYNAME = python
  let RM = rd /s /q
  let OS_DIST = dist\\
  let CLS = cls
elif OS==linux then
  let PYNAME = python3
  let RM = rm -rf
  let OS_DIST = dist/
  let CLS = clean
else then
  let PYNAME = python3
  let RM = rm -rf
  let OS_DIST = dist/
  let CLS = clean
done

recipe clean
recipe full
recipe build
recipe upload
recipe verboseupload
recipe verbosefull

let PROGRAM = arghandle

clean:
  shell (RM) (PROGRAM)-* (PROGRAM).egg-info (OS_DIST)
full:
  (PYNAME) -m build
  (PYNAME) -m twine upload (OS_DIST)*
  echo "Finished!"
build:
  (PYNAME) -m build
  shell echo FINISHED BUILD!
upload:
  (PYNAME) -m twine upload (OS_DIST)*
  echo "Finished!"
verboseupload:
  (PYNAME) -m twine upload (OS_DIST)* --verbose
  shell (CLS)
  echo "Finished upload!"
verbosefull:
  (PYNAME) -m build
  (PYNAME) -m twine upload (OS_DIST)* --verbose
  echo "Finished!"
